# Modèle : copiez-le en .env et renseignez les valeurs. Le .env est ignoré par git
# (voir .gitignore) — ce dépôt est PUBLIC, une clé poussée ici serait compromise
# définitivement et permettrait d'émettre des licences et de pousser du code sur
# tous les postes installés.
#
# Le trousseau du Mac reste la meilleure place pour ces valeurs ; le .env n'est
# qu'un dépannage. Les valeurs se copient depuis les réglages de votre
# environnement sur claude.ai/code.

# Clé de signature des LICENCES — PEM Ed25519 encodé en base64, non chiffré
PODONOTE_LICENSE_KEY_B64=

# Clé de signature des MISES À JOUR — PEM Ed25519 chiffré, encodé en base64
PODONOTE_SIGN_KEY_B64=
PODONOTE_SIGN_PASSPHRASE=
